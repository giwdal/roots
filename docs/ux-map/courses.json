{
  "area": "courses",
  "label": "Kurse",
  "module": "courses",
  "nav": [
    { "label": "Kurse", "key": "courses.nav", "href": "/courses", "permission": "courses.view" }
  ],
  "pages": [
    {
      "route": "/courses",
      "file": "src/app/(app)/courses/page.tsx",
      "title": "Kurse (trash: \"Kurse · Papierkorb\")",
      "purpose": "List of courses with next date, places taken and waiting list; entry to each course; trash view.",
      "permission": "courses.view (layout also requires the courses module)",
      "size": "list",
      "header": {
        "area": "courses",
        "menu": [{ "label": "Papierkorb | Zurück zur Liste", "key": "courses.trash / courses.backToList", "target": "/courses?status=trash | /courses", "permission": "courses.manage" }],
        "primary": { "label": "Neuer Kurs", "key": "courses.new", "href": "/courses/new", "permission": "courses.manage", "notes": "hidden in trash" }
      },
      "urlState": [
        { "param": "q", "meaning": "search title + instructor" },
        { "param": "status", "meaning": "trash = trash view (courses.manage)" },
        { "param": "page", "meaning": "Pager (Neuer / Älter)" },
        { "param": "new", "meaning": "legacy: redirects to /courses/new" }
      ],
      "sections": [
        { "title": "Toolbar", "kind": "custom", "fields": [{ "name": "q", "label": "Kurs oder Leitung suchen…", "key": "courses.search", "type": "search", "component": "SearchBox" }] },
        { "title": "Kurse", "kind": "DataTable", "columns": ["Kurs (+ Leitung; link → /courses/<id>)", "Nächster Termin", "Belegt ('{enrolled} / {capacity}' + badges 'voll', '{count} warten')"] }
      ],
      "actions": [],
      "links": ["/courses/new", "/courses/[id]"],
      "empty": "DataTable empty text 'Noch keine Kurse.' / 'Kein Kurs gefunden.' (no EmptyState with action)",
      "phone": "DataTable cards; primary round +.",
      "uxNotes": [
        "No export on the list (only per-course participant export).",
        "No <EmptyState> on a never-used list.",
        "Trashed courses in the list have no restore button; restore only by opening the course (contrast: projects/rentals restore inline).",
        "No filter for upcoming/past courses; sorted by title only."
      ]
    },
    {
      "route": "/courses/new",
      "file": "src/app/(app)/courses/new/page.tsx",
      "title": "Neuer Kurs",
      "purpose": "Create a course (title, instructor, places, location, description, attendance tracking).",
      "permission": "courses.manage",
      "size": "form (NewPage)",
      "header": { "crumbs": ["Kurse", "Neuer Kurs"] },
      "sections": [
        {
          "title": "Kursdaten",
          "anchor": "#details",
          "kind": "FormCard",
          "fields": [
            { "name": "title", "label": "Kurs", "key": "courses.titleLabel", "type": "text", "component": "Input", "required": true, "notes": "placeholder 'z. B. Yoga für Einsteiger'" },
            { "name": "instructor", "label": "Leitung", "key": "courses.instructor", "type": "text", "component": "Input", "notes": "free text, not a person/contact" },
            { "name": "capacity", "label": "Plätze", "key": "courses.capacity", "type": "number", "component": "TypedInput:number", "notes": "placeholder 'unbegrenzt'" },
            { "name": "location_id", "label": "Ort", "key": "courses.location", "type": "choice", "component": "Choice", "notes": "only with locations" },
            { "name": "description", "label": "Beschreibung", "key": "courses.description", "type": "textarea", "component": "Textarea" },
            { "name": "track_attendance", "label": "Anwesenheit erfassen", "key": "courses.trackAttendance", "type": "checkbox", "component": "native checkbox", "notes": "default on" }
          ]
        }
      ],
      "actions": [
        { "label": "Kurs anlegen", "key": "courses.create", "where": "savebar", "kind": "serverAction", "target": "saveCourse", "permission": "courses.manage", "confirm": false, "result": "→ /courses/<id>#dates, toast 'Kurs angelegt – jetzt Termine eintragen.'" }
      ],
      "links": ["/courses"],
      "uxNotes": ["Dates can't be entered on create; a second step on the course page (toast nudges to it)."]
    },
    {
      "route": "/courses/[id]",
      "file": "src/app/(app)/courses/[id]/page.tsx",
      "title": "<Course title>",
      "purpose": "One course: participants (enrolled, waiting list, cancelled) with attendance rate, dates (single or weekly series), course details on the side.",
      "permission": "courses.view (edit: courses.manage)",
      "size": "record",
      "header": {
        "crumbs": ["Kurse", "<Title>"],
        "meta": "'<Leitung> · {taken} von {total} Plätzen belegt' (or '{count} Teilnehmende')",
        "menu": [
          { "label": "Teilnehmende (export)", "key": "courses.participants", "target": "/export/course-participants?course=<id>", "notes": "MenuExport" },
          { "label": "In den Papierkorb", "key": "courses.toTrash", "target": "trashCourse (MenuSubmit destructive)", "permission": "courses.manage" }
        ]
      },
      "urlState": [
        { "param": "new", "meaning": "series = 'Regelmäßige Termine' sheet | date = 'Einzelner Termin' sheet" },
        { "param": "ok / error", "meaning": "toast" }
      ],
      "sections": [
        {
          "title": "Teilnehmende",
          "anchor": "#participants",
          "kind": "custom",
          "fields": [
            { "name": "contact_id", "label": "Person hinzufügen", "key": "courses.addPerson", "type": "contact", "component": "ContactPicker", "notes": "placeholder 'Kontakt suchen…'" },
            { "name": "note", "label": "Notiz", "key": "courses.note", "type": "text", "component": "Input" }
          ],
          "notes": "Inline add row (courses.manage) + button 'Hinzufügen'. Enrolled rows: name → /contacts/<id>, note, badge '{rate} % da', button 'Abmelden'. 'Warteliste' numbered (dashed) with 'Abmelden'. <details> '{count} Abmeldungen' with 'Wieder aufnehmen'. Empty 'Noch niemand angemeldet.'"
        },
        {
          "title": "Termine",
          "anchor": "#dates",
          "kind": "custom",
          "notes": "card actions 'Regelmäßige Termine' (?new=series) and 'Einzelner Termin' (?new=date); rows → /courses/<id>/sessions/<sid> with date, note, badge 'fällt aus' or '{present} von {total} da'. Empty 'Noch keine Termine.'"
        },
        { "title": "Kursdaten (aside)", "anchor": "#details", "kind": "FormCard", "notes": "CourseForm (same fields as /courses/new), disabled for courses.view" }
      ],
      "actions": [
        { "label": "Hinzufügen", "key": "courses.add", "where": "section", "kind": "serverAction", "target": "addParticipant", "permission": "courses.manage", "confirm": false, "result": "toast 'Hinzugefügt.' or 'Der Kurs ist voll – auf die Warteliste gesetzt.'; duplicate 'Diese Person ist schon im Kurs.'" },
        { "label": "Abmelden", "key": "courses.remove", "where": "row", "kind": "serverAction", "target": "setParticipantStatus status=cancelled", "permission": "courses.manage", "confirm": false, "result": "toast 'Abgemeldet. Wer auf der Warteliste steht, rückt nach.'" },
        { "label": "Wieder aufnehmen", "key": "courses.reEnrol", "where": "row", "kind": "serverAction", "target": "setParticipantStatus status=enrolled", "permission": "courses.manage", "confirm": false },
        { "label": "Speichern", "where": "savebar", "kind": "serverAction", "target": "saveCourse", "permission": "courses.manage", "confirm": false, "result": "toast 'Gespeichert.'" },
        { "label": "In den Papierkorb", "key": "courses.toTrash", "where": "menu", "kind": "confirm", "target": "trashCourse", "permission": "courses.manage", "confirm": true, "result": "→ /courses, toast 'Kurs in den Papierkorb gelegt.'" },
        { "label": "Wiederherstellen", "key": "courses.restore", "where": "section", "kind": "serverAction", "target": "restoreCourse", "permission": "courses.manage", "confirm": false, "notes": "trashed course shows only hint courses.inTrash + this button" }
      ],
      "overlays": [
        {
          "param": "?new=series",
          "component": "UrlSheet",
          "title": "Regelmäßige Termine",
          "fields": [
            { "name": "weekdays", "label": "Wochentage (sr-only legend)", "key": "courses.weekdays", "type": "checkbox[]", "component": "native checkboxes Mo–So" },
            { "name": "start_time", "label": "Beginn", "key": "courses.startTime", "type": "time", "component": "Input type=time", "required": true, "notes": "default 18:00" },
            { "name": "end_time", "label": "Ende", "key": "courses.endTime", "type": "time", "component": "Input type=time", "required": true, "notes": "default 19:30" },
            { "name": "from", "label": "Ab", "key": "courses.from", "type": "date", "component": "DateInput:date", "required": true },
            { "name": "to", "label": "Bis", "key": "courses.to", "type": "date", "component": "DateInput:date", "required": true },
            { "name": "every_weeks", "label": "Alle [n] Woche(n)", "key": "courses.every / courses.weeks", "type": "number", "component": "Input type=number (inline in sentence)" }
          ],
          "actions": [{ "label": "Termine anlegen", "key": "courses.createDates", "where": "sheet", "kind": "serverAction", "target": "addSessions mode=series", "confirm": false, "result": "toast '{count} Termine angelegt.' (max 200)" }]
        },
        {
          "param": "?new=date",
          "component": "UrlSheet",
          "title": "Einzelner Termin",
          "fields": [
            { "name": "starts_at", "label": "Beginn", "key": "courses.start", "type": "datetime", "component": "DateInput:datetime-local", "required": true },
            { "name": "ends_at", "label": "Ende", "key": "courses.end", "type": "datetime", "component": "DateInput:datetime-local", "required": true }
          ],
          "actions": [{ "label": "Hinzufügen", "key": "courses.add", "where": "sheet", "kind": "serverAction", "target": "addSessions", "confirm": false, "result": "toast '1 Termin angelegt.'" }]
        }
      ],
      "links": ["/courses", "/contacts/[id]", "/courses/[id]/sessions/[sessionId]", "/export/course-participants"],
      "phone": "RecordLayout: course details (aside) below participants and dates.",
      "uxNotes": [
        "'Abmelden' (cancel a participant, moves the waiting list up) has no confirm.",
        "Date sheets use a plain SubmitButton (justify-self-end), not <SaveBar> like other create sheets.",
        "Series times use native <input type=time> (browser locale), against the DateInput rule.",
        "Weekday checkboxes have only an sr-only legend: no visible label in the series sheet.",
        "Participants are not a <DataTable> (hand-built list rows), so no bulk actions, no cards on phones, no paging.",
        "The edit form (Kursdaten) sits in the aside, the lists in the main column (same as rentals objects, unlike HR/projects).",
        "'Leitung' is free text, not linked to HR employees or shift staff.",
        "Dates appear here but there is no calendar view of a course; the shared /calendar links back here, not to the session."
      ]
    },
    {
      "route": "/courses/[id]/sessions/[sessionId]",
      "file": "src/app/(app)/courses/[id]/sessions/[sessionId]/page.tsx",
      "title": "<Weekday, date, time of the session>",
      "purpose": "One course date: tick who was there, change time/note, mark as cancelled, delete.",
      "permission": "courses.view (edit: courses.manage)",
      "size": "form",
      "header": { "crumbs": ["Kurse", "<Course title> (→ /courses/<id>#dates)", "<date>"] },
      "sections": [
        {
          "title": "Anwesenheit",
          "anchor": "#attendance",
          "kind": "custom",
          "fields": [{ "name": "present", "label": "<participant name>", "type": "checkbox[]", "component": "native checkbox rows (size-5, min-h-10)" }],
          "notes": "only when the course tracks attendance and the date isn't cancelled; enrolled participants; empty 'Noch niemand angemeldet.'"
        },
        {
          "title": "Termin ändern",
          "anchor": "#date",
          "kind": "FormCard",
          "fields": [
            { "name": "starts_at", "label": "Beginn", "key": "courses.start", "type": "datetime", "component": "DateInput:datetime-local", "required": true },
            { "name": "ends_at", "label": "Ende", "key": "courses.end", "type": "datetime", "component": "DateInput:datetime-local", "required": true },
            { "name": "note", "label": "Notiz", "key": "courses.note", "type": "text", "component": "Input", "notes": "placeholder 'z. B. Raum 2 oder Ersatz-Leitung'" },
            { "name": "cancelled", "label": "Termin fällt aus", "key": "courses.cancelDate", "type": "checkbox", "component": "native checkbox" }
          ],
          "notes": "courses.manage only. Cancelled date shows banner 'Dieser Termin fällt aus.'"
        }
      ],
      "actions": [
        { "label": "Anwesenheit speichern", "key": "courses.saveAttendance", "where": "section", "kind": "serverAction", "target": "saveAttendance", "permission": "courses.manage", "confirm": false, "result": "toast 'Anwesenheit gespeichert.'" },
        { "label": "Speichern", "key": "common.save", "where": "section", "kind": "serverAction", "target": "updateSession", "permission": "courses.manage", "confirm": false, "result": "toast 'Gespeichert.'; clash → 'Zu dieser Zeit gibt es schon einen Termin.'" },
        { "label": "Termin löschen", "key": "courses.deleteDate", "where": "section", "kind": "serverAction", "target": "deleteSession", "permission": "courses.manage", "confirm": false, "result": "→ /courses/<id>#dates, toast 'Termin gelöscht.'" }
      ],
      "links": ["/courses", "/courses/[id]"],
      "phone": "Attendance rows are large tap targets (min-h-10, size-5 checkboxes).",
      "uxNotes": [
        "A small record (date + note) is a full page instead of a sheet on the course (docs: small records → ?edit=<id> drawer).",
        "Two plain 'save' buttons in two forms (attendance, date) instead of <SaveBar>; no unsaved-changes guard.",
        "'Termin löschen' is an outline button inside the edit card, no confirm, not a red ⋯ item.",
        "Cancelling a date is a checkbox saved with the edit form, no confirm.",
        "No prev/next session navigation for taking attendance week by week; no 'all present' shortcut."
      ]
    }
  ]
}
