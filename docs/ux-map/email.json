{
  "area": "communication",
  "label": "Kommunikation › E-Mail",
  "module": "email",
  "nav": [
    {
      "label": "E-Mail-Kampagnen",
      "href": "/email"
    },
    {
      "label": "E-Mail-Automationen",
      "href": "/email/automations"
    },
    {
      "label": "E-Mail-Vorlagen",
      "href": "/email/templates"
    },
    {
      "label": "E-Mail-Versand",
      "href": "/email/log"
    }
  ],
  "pages": [
    {
      "route": "/email",
      "file": "src/app/(app)/email/page.tsx",
      "title": "Kampagnen",
      "purpose": "List email campaigns (draft, scheduled, sending, sent) and create a new one.",
      "permission": "email.view",
      "size": "list (no <Page>; layout grid max-w-6xl)",
      "header": {
        "area": "communication",
        "primary": {
          "label": "Neue Kampagne",
          "key": "email.newCampaign",
          "href": "?new=1",
          "permission": "email.manage"
        }
      },
      "urlState": [
        {
          "param": "new",
          "meaning": "1 = create sheet"
        },
        {
          "param": "ok / error",
          "meaning": "toast"
        }
      ],
      "sections": [
        {
          "title": "Kampagnen",
          "kind": "DataTable",
          "columns": [
            "Name (+ Betreff)",
            "Status (Entwurf / Geplant · date / Wird versendet / Versendet)",
            "Empfänger:innen (– for draft/scheduled)"
          ],
          "notes": "Row → /email/<id>. Max 200 rows, no pagination."
        }
      ],
      "overlays": [
        {
          "param": "?new=1",
          "component": "UrlSheet",
          "title": "Neue Kampagne",
          "fields": [
            {
              "name": "name",
              "label": "Name",
              "key": "email.name",
              "type": "text",
              "component": "Input",
              "required": true,
              "notes": "placeholder 'z. B. Newsletter Oktober'"
            }
          ],
          "actions": [
            {
              "label": "Anlegen",
              "key": "email.create",
              "kind": "serverAction",
              "target": "createCampaign",
              "result": "→ /email/<id> (no toast)"
            }
          ]
        }
      ],
      "links": [
        "/email/[id]"
      ],
      "empty": "EmptyState 'Noch keine Kampagnen.' / 'Eine Kampagne ist eine E-Mail an viele: an Tags oder alle aktiven Mitglieder, sofort oder geplant.' + 'Neue Kampagne'",
      "uxNotes": [
        "Campaigns are soft-deleted (trash from the campaign page) but there is no trash view or restore anywhere.",
        "No search, filter or ⋯ menu; sidebar label 'E-Mail-Kampagnen' vs page title 'Kampagnen'.",
        "A one-field sheet only to name the campaign before the real editor page – an extra step."
      ]
    },
    {
      "route": "/email/[id]",
      "file": "src/app/(app)/email/[id]/page.tsx",
      "title": "Kampagne (name)",
      "purpose": "Write a campaign, choose recipients, send a test, schedule or send now; after sending, see delivery stats.",
      "permission": "email.view",
      "size": "record (no <Page>)",
      "header": {
        "crumbs": [
          "Kampagnen",
          "<Name>"
        ],
        "badge": "status (+ scheduled date)",
        "meta": "after sending: '{sent} versendet · {queued} in der Warteschlange · {failed} fehlgeschlagen · {skipped} übersprungen' + delivery stats",
        "menu": [
          {
            "label": "Planung aufheben",
            "key": "email.unschedule",
            "target": "unscheduleCampaign",
            "notes": "scheduled only",
            "confirm": false
          },
          {
            "label": "In den Papierkorb",
            "key": "email.toTrash",
            "target": "trashCampaign (destructive)",
            "confirm": true,
            "notes": "not while sending; also offered for sent campaigns"
          }
        ]
      },
      "urlState": [
        {
          "param": "ok / error",
          "meaning": "toast"
        }
      ],
      "sections": [
        {
          "title": "Inhalt",
          "key": "email.content",
          "anchor": "#content",
          "kind": "FormCard",
          "fields": [
            {
              "name": "name",
              "label": "Name",
              "key": "email.name",
              "type": "text",
              "component": "Input",
              "required": true
            },
            {
              "name": "subject",
              "label": "Betreff",
              "key": "email.subject",
              "type": "text",
              "component": "Input"
            },
            {
              "name": "format + body",
              "label": "Format: Text / Editor / Eigenes HTML",
              "key": "email.format",
              "type": "richtext|html",
              "component": "EmailBodyField",
              "notes": "placeholders BASE_PLACEHOLDERS"
            }
          ]
        },
        {
          "title": "Empfänger:innen",
          "key": "email.audience",
          "anchor": "#audience",
          "kind": "FormCard",
          "description": "email.audienceHint, or 'Geht an {count} Personen.' once chosen",
          "fields": [
            {
              "name": "tags",
              "label": "Kontakte mit einem dieser Tags",
              "key": "email.audienceTags",
              "type": "tags",
              "component": "TagSelect (not creatable)"
            },
            {
              "name": "members",
              "label": "Alle aktiven Mitglieder",
              "key": "email.audienceMembers",
              "type": "checkbox",
              "notes": "members module only"
            }
          ]
        },
        {
          "title": "Versand",
          "key": "email.sending",
          "anchor": "#send",
          "kind": "FormCard",
          "fields": [
            {
              "name": "send_at",
              "label": "Senden am",
              "key": "email.sendAt",
              "type": "datetime-local",
              "component": "DateInput"
            }
          ],
          "notes": "Only while editable (draft/scheduled + email.manage). Buttons submit the same form with intent=test|schedule|send."
        }
      ],
      "actions": [
        {
          "label": "Speichern",
          "where": "savebar",
          "kind": "serverAction",
          "target": "saveCampaign",
          "result": "toast email.saved"
        },
        {
          "label": "Test an mich",
          "key": "email.sendTest",
          "where": "section",
          "kind": "serverAction",
          "target": "saveCampaign intent=test",
          "result": "saves, then toast 'Test an {email} verschickt.' or email.noProvider"
        },
        {
          "label": "Planen",
          "key": "email.schedule",
          "where": "section",
          "kind": "serverAction",
          "target": "saveCampaign intent=schedule",
          "confirm": false,
          "result": "toast email.scheduled; past date → email.scheduleInvalid"
        },
        {
          "label": "Jetzt senden",
          "key": "email.sendNow",
          "where": "section",
          "kind": "serverAction",
          "target": "saveCampaign intent=send",
          "confirm": false,
          "result": "toast 'Wird an {count} Personen versendet.'"
        }
      ],
      "links": [
        "/email"
      ],
      "phone": "Aside (audience, sending) stacks below the content card.",
      "uxNotes": [
        "'Jetzt senden' mails the whole audience with no confirmation and no recipient count on the button (count is in the audience card description, only after saving).",
        "Recipient count only refreshes after a save; changing tags shows no live reach.",
        "Send/test/schedule buttons sit inside the edit form and also save it, while the SaveBar is the separate save path.",
        "After sending, the page shows totals only; no per-recipient list (the send log is a separate, unfiltered page).",
        "Audience = tags or active members only; no link to preview who exactly is included."
      ]
    },
    {
      "route": "/email/automations",
      "file": "src/app/(app)/email/automations/page.tsx",
      "title": "Automationen",
      "purpose": "Event + delay → email to the person concerned; several on one event form a sequence.",
      "permission": "email.view",
      "size": "list (no <Page>)",
      "header": {
        "area": "communication",
        "description": "email.automationsHint",
        "primary": {
          "label": "Neue Automation",
          "key": "email.newAutomation",
          "href": "/email/automations?new=1",
          "permission": "email.manage"
        }
      },
      "urlState": [
        {
          "param": "new",
          "meaning": "1 = create sheet"
        },
        {
          "param": "edit",
          "meaning": "<id> = edit sheet"
        }
      ],
      "sections": [
        {
          "title": "Automationen",
          "kind": "DataTable",
          "columns": [
            "Name (+ Betreff)",
            "Auslöser (event type)",
            "Wartezeit (sofort / n Tage/Stunden/Minuten)",
            "Status (aktiv / pausiert)"
          ],
          "notes": "Row → ?edit=<id>; sorted by event then delay"
        }
      ],
      "overlays": [
        {
          "param": "?new=1 | ?edit=<id>",
          "component": "UrlSheet (wide)",
          "title": "Neue Automation / name",
          "fields": [
            {
              "name": "name",
              "label": "Name",
              "key": "email.name",
              "type": "text",
              "component": "Input",
              "required": true
            },
            {
              "name": "event_type",
              "label": "Auslöser",
              "key": "email.trigger",
              "type": "select",
              "component": "NativeSelect",
              "notes": "AUTOMATION_EVENTS of enabled modules"
            },
            {
              "name": "delay",
              "label": "Wartezeit",
              "key": "email.delay",
              "type": "number",
              "component": "Input type=number"
            },
            {
              "name": "unit",
              "label": "Einheit",
              "key": "email.unit",
              "type": "select",
              "component": "NativeSelect",
              "notes": "Minuten / Stunden / Tage"
            },
            {
              "name": "subject",
              "label": "Betreff",
              "key": "email.subject",
              "type": "text",
              "component": "Input",
              "required": true
            },
            {
              "name": "format + body",
              "type": "richtext|html|text",
              "component": "EmailBodyField",
              "notes": "placeholders = base + event vars; new automations start in format 'text'"
            },
            {
              "name": "active",
              "label": "aktiv",
              "key": "email.active",
              "type": "checkbox",
              "notes": "default on"
            }
          ],
          "actions": [
            {
              "label": "Anlegen / Speichern",
              "key": "email.create",
              "where": "savebar",
              "kind": "serverAction",
              "target": "saveAutomation",
              "result": "toast email.saved; missing fields → email.automationInvalid"
            },
            {
              "label": "Löschen",
              "key": "email.delete",
              "where": "sheet",
              "kind": "serverAction",
              "target": "deleteAutomation (hard delete)",
              "confirm": false,
              "notes": "red ghost button at the bottom"
            }
          ]
        }
      ],
      "links": [],
      "empty": "EmptyState 'Noch keine Automationen.' (no text, no action button)",
      "uxNotes": [
        "Delete is a bottom ghost button without confirm (templates sheet uses a ⋯ destructive item with confirm).",
        "No test-send for automations (campaigns and templates have one).",
        "New automations default to plain 'Text' format, new campaigns/templates to the editor.",
        "Overlaps with the separate Automations module (/automations workflows) which can also send emails – two places for 'send an email when X'.",
        "Area page shows a description sentence (guide: no intro sentences on overviews)."
      ]
    },
    {
      "route": "/email/templates",
      "file": "src/app/(app)/email/templates/page.tsx",
      "title": "Vorlagen",
      "purpose": "Design of event mails (tickets, guest-list tickets, waiting list) and, with the shop, the shop buyer mail texts.",
      "permission": "email.view",
      "size": "list (no <Page>)",
      "header": {
        "area": "communication",
        "description": "email.templates.hint",
        "primary": {
          "label": "Neue Vorlage",
          "key": "email.templates.new",
          "href": "/email/templates?new=1",
          "permission": "email.manage"
        }
      },
      "urlState": [
        {
          "param": "new",
          "meaning": "1 = create sheet"
        },
        {
          "param": "edit",
          "meaning": "<id> or 'builtin'"
        }
      ],
      "sections": [
        {
          "title": "Vorlagen",
          "kind": "DataTable",
          "columns": [
            "Name (+ Betreff)",
            "Status ('Standard' badge)"
          ],
          "notes": "First row is always the built-in 'roots-Standard'. Row → ?edit=<id>|builtin"
        },
        {
          "title": "Shop-Mails",
          "key": "email.templates.shopMails",
          "anchor": "#shop",
          "kind": "FormCard",
          "description": "email.templates.shopMailsHint",
          "notes": "Only with shop module + shop.manage. Per mail kind (Bestellbestätigung, Zahlung erhalten, Abholbereit, Versendet, Storniert, Erschienen, Erstattung): on/off checkbox + 'Eigener Text' textarea. SaveBar → saveShopMails (same data as Shop → Einstellungen)."
        }
      ],
      "overlays": [
        {
          "param": "?edit=builtin",
          "component": "UrlSheet (wide)",
          "title": "roots-Standard",
          "fields": [],
          "notes": "Hint email.templates.builtInHint, subject + raw HTML in a hand-made <dl>, placeholder list (<details>).",
          "actions": [
            {
              "label": "Kopieren & anpassen",
              "key": "email.templates.copy",
              "kind": "serverAction",
              "target": "copyBuiltInTemplate",
              "permission": "email.manage",
              "result": "→ ?edit=<new id>"
            }
          ]
        },
        {
          "param": "?new=1 | ?edit=<id>",
          "component": "UrlSheet (wide)",
          "title": "Neue Vorlage / name",
          "fields": [
            {
              "name": "name",
              "label": "Name",
              "key": "email.name",
              "type": "text",
              "component": "Input",
              "required": true
            },
            {
              "name": "subject",
              "label": "Betreff",
              "key": "email.subject",
              "type": "text",
              "component": "Input",
              "required": true
            },
            {
              "name": "format + body",
              "component": "EmailBodyField",
              "notes": "EVENT_PLACEHOLDERS; hint email.templates.placeholderHint + placeholder list"
            },
            {
              "name": "is_default",
              "label": "Standardvorlage für alle Events",
              "key": "email.templates.makeDefault",
              "type": "checkbox"
            }
          ],
          "actions": [
            {
              "label": "Anlegen / Speichern",
              "where": "savebar",
              "kind": "serverAction",
              "target": "saveTemplateAction",
              "result": "→ ?edit=<id> toast email.saved"
            },
            {
              "label": "Testmail an mich",
              "key": "email.templates.test",
              "where": "menu",
              "kind": "serverAction",
              "target": "testTemplate"
            },
            {
              "label": "Löschen",
              "key": "email.delete",
              "where": "menu",
              "kind": "confirm",
              "target": "deleteTemplate",
              "confirm": true,
              "notes": "confirm email.templates.confirmDelete"
            }
          ]
        }
      ],
      "links": [],
      "uxNotes": [
        "Name 'Vorlagen' collides with Dateien → Vorlagen (letter templates); these are event-mail templates only, which the title does not say.",
        "Shop buyer mails are editable here and in Shop → Einstellungen (duplicate path), in a form below the table on the same page.",
        "The built-in template sheet shows raw HTML in a hand-made <dl> instead of a rendered preview / <DetailList>.",
        "Templates do not apply to campaigns or automations, only event and shop mails."
      ]
    },
    {
      "route": "/email/log",
      "file": "src/app/(app)/email/log/page.tsx",
      "title": "Versand",
      "purpose": "Every mail sent in the org's name (queue + system mails, 90 days), with status and delivery.",
      "permission": "email.view",
      "size": "list (no <Page>)",
      "header": {
        "area": "communication",
        "description": "email.logHint"
      },
      "urlState": [
        {
          "param": "q",
          "meaning": "search recipient or subject"
        },
        {
          "param": "view",
          "meaning": "all (default) | system | bulk"
        },
        {
          "param": "page",
          "meaning": "pagination"
        }
      ],
      "sections": [
        {
          "title": "Toolbar",
          "kind": "custom",
          "fields": [
            {
              "name": "q",
              "label": "Empfänger:in oder Betreff",
              "key": "email.logSearch",
              "component": "SearchBox"
            },
            {
              "name": "view",
              "label": "Alle · System-Mails · Kampagnen & Automationen",
              "key": "email.logViews.*",
              "component": "Segments"
            }
          ]
        },
        {
          "title": "Versand",
          "kind": "DataTable",
          "columns": [
            "An (+ Betreff)",
            "Art (linked to the record: shop order, event, invoice, contact, form, campaign, automation, workflow)",
            "Status (+ delivery, error)",
            "Zeitpunkt"
          ],
          "notes": "No row link; only the 'Art' cell links."
        }
      ],
      "links": [
        "/shop/orders/[id]",
        "/events/[id]",
        "/invoices/[id]",
        "/contacts/[id]",
        "/forms/[id]",
        "/email/[id]",
        "/email/automations?edit=",
        "/automations/[id]"
      ],
      "empty": "'Noch nichts versendet.'",
      "uxNotes": [
        "No filter by contact or campaign in the URL, so the contact page and campaign page can't deep-link into 'their' mails (contact page links here unfiltered).",
        "Uses <Segments> correctly, while members/dues/submissions hand-build the same chips.",
        "No resend/retry for failed mails."
      ]
    }
  ]
}
